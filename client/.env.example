# Base URL of the ExamSentinel API (no trailing slash)
API_BASE_URL=http://127.0.0.1:5000/api/v1

# Set to 1 to skip VM detection gates during development (never in production)
# SKIP_VM_CHECK=0

# Set to 1 to skip stealth VM detection (RDTSC timing) — Version A demo build
# SKIP_STEALTH_CHECK=0

# Set to 1 to skip OS lockdown entirely (for dev iteration on non-Windows or
# when admin privileges are unavailable). NEVER set for the actual demo.
# SKIP_LOCKDOWN=0

# HTTP request timeout in seconds
# REQUEST_TIMEOUT_SECONDS=10
