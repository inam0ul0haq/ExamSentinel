# PostgreSQL connection string (Railway injects this automatically)
DATABASE_URL=

# Flask secret key for session signing (generate a random 64-char hex string)
SECRET_KEY=

# Secret key used by Flask-JWT-Extended to sign JWTs (separate from SECRET_KEY)
JWT_SECRET_KEY=

# Flask environment: development | production
FLASK_ENV=development

# Comma-separated list of origins allowed by CORS (e.g. http://localhost:5000)
CORS_ALLOWED_ORIGINS=*

# Port the server listens on (Railway sets this automatically)
PORT=5000

# Token required by POST /api/v1/_seed (X-Seed-Token header). When unset
# or empty the seed endpoint always returns 404. Generate a long random
# string for production: `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
SEED_TOKEN=
